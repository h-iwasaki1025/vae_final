# Python / Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Data Files (Exclude contents of data directories, keep structure)
02_data/raw/*
!02_data/raw/.gitkeep
02_data/interim/*
!02_data/interim/.gitkeep
02_data/processed/*
!02_data/processed/.gitkeep

# Large Models & Checkpoints
*.pt
*.pth
*.ckpt
*.h5
*.onnx

# Large Generated Results & Media
06_results/*
!06_results/.gitkeep
*.png
*.jpg
*.jpeg
*.gif
*.mp4

# Environment & Secrets
.env
.env.local
*.key
venv/
.venv/

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
